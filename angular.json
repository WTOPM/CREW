{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "bfe49614-61bc-40bf-b75f-c52ad0d404cd"
  },
  "newProjectRoot": "projects",
  "projects": {
    "crew": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public",
                "ignore": ["crew-data.json"]
              },
              {
                "glob": "pdf.worker*.mjs",
                "input": "node_modules/pdfjs-dist/build",
                "output": ""
              },
              {
                "glob": "html2canvas.min.js",
                "input": "node_modules/html2canvas/dist",
                "output": "forms/vendor"
              },
              {
                "glob": "exceljs.min.js",
                "input": "node_modules/exceljs/dist",
                "output": "forms/vendor"
              }
            ],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "electron": {
              "baseHref": "./",
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public",
                  "ignore": ["crew-data.json"]
                },
                {
                  "glob": "pdf.worker*.mjs",
                  "input": "node_modules/pdfjs-dist/build",
                  "output": ""
                },
                {
                  "glob": "html2canvas.min.js",
                  "input": "node_modules/html2canvas/dist",
                  "output": "forms/vendor"
                },
                {
                  "glob": "exceljs.min.js",
                  "input": "node_modules/exceljs/dist",
                  "output": "forms/vendor"
                }
              ],
              "outputHashing": "all"
            },
            "production": {
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "crew:build:production"
            },
            "development": {
              "buildTarget": "crew:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
