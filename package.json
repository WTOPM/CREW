{
  "name": "crew",
  "version": "0.92.1",
  "description": "CREW Documents — ship documentation, crew and passenger lists, IMO PDF forms (Windows portable)",
  "author": "WTOPM",
  "main": "electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:electron": "ng build --configuration electron",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss,json}\"",
    "electron:dev": "concurrently -k \"ng serve\" \"wait-on http://localhost:4200 && electron .\"",
    "electron:build": "npm run build:electron && electron-builder --win portable",
    "electron:pack": "npm run build:electron && electron-builder --dir",
    "import:document": "node scripts/import-document-xlsx.mjs DOCUMENT.xlsx",
    "build:un-reference": "node scripts/build-un-numbers-reference.mjs",
    "sync:un-reference": "node scripts/sync-un-numbers-from-adr-tool.mjs",
    "render:ship-stores-bg": "node scripts/render-ship-stores-bg.mjs"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/cdk": "^21.2.13",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.0.227",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular/build": "^21.2.13",
    "@angular/cli": "^21.2.13",
    "@angular/compiler-cli": "^21.2.0",
    "@types/node": "^25.9.1",
    "canvas": "^3.2.3",
    "concurrently": "^10.0.0",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^28.0.0",
    "playwright": "^1.61.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.crew.documents",
    "productName": "CREW Documents",
    "directories": {
      "output": "CREW-App"
    },
    "extraFiles": [
      {
        "from": "build/data-path.txt.example",
        "to": "data-path.txt.example"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "CREW-Documents.exe"
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "canvas@3.2.3": true,
    "core-js@3.49.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.27.3": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.4": true
  }
}
